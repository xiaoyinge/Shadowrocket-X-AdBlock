#!name=X 去广告 (仅 GraphQL)
#!desc=只解密 api.x.com 的 GraphQL 响应; 显式排除 chat-ws/video/pbs/abs 等长连接与媒体子域, 避免拆散 App 的 h2 会话。模块规则优先于配置文件。
#!system=ios
#!author=xiaoyinge
#!homepage=https://raw.githubusercontent.com/xiaoyinge/Shadowrocket-X-AdBlock/main/README.md

[Rule]
# ================= X / Twitter =================
DOMAIN-SUFFIX,ads-twitter.com,REJECT
DOMAIN-SUFFIX,ads-api.twitter.com,REJECT
DOMAIN-SUFFIX,ads.twitter.com,REJECT
DOMAIN-SUFFIX,analytics.twitter.com,REJECT
DOMAIN-SUFFIX,ads.x.com,REJECT
DOMAIN-SUFFIX,ads-api.x.com,REJECT
DOMAIN-SUFFIX,tellapart.com,REJECT
DOMAIN-SUFFIX,scribe.twitter.com,REJECT

# ================= Google 广告 (doubleclick 是重连大户) =================
# 日志实证: 单次 30s 会话内 googleads.g.doubleclick-cn.net 重连 12~26 次
# 用 REJECT-DROP 静默丢包: App 等 TCP 超时后放弃, 不再快速重连
DOMAIN-SUFFIX,doubleclick.net,REJECT-DROP
DOMAIN-SUFFIX,doubleclick-cn.net,REJECT-DROP
DOMAIN-SUFFIX,doubleclick.com,REJECT-DROP
DOMAIN-SUFFIX,g.doubleclick.net,REJECT-DROP
DOMAIN-SUFFIX,googlesyndication.com,REJECT
DOMAIN-SUFFIX,googleadservices.com,REJECT
DOMAIN-SUFFIX,google-analytics.com,REJECT
DOMAIN-SUFFIX,googletagmanager.com,REJECT
DOMAIN-SUFFIX,googletagservices.com,REJECT
DOMAIN-SUFFIX,adservice.google.com,REJECT
DOMAIN-SUFFIX,pagead2.googlesyndication.com,REJECT
DOMAIN-SUFFIX,firebaselogging-pa.googleapis.com,REJECT
DOMAIN-SUFFIX,firebaseinstallations.googleapis.com,REJECT

# ================= 遥测 / 崩溃上报 =================
DOMAIN-SUFFIX,ingest.us.sentry.io,REJECT
DOMAIN-SUFFIX,app-measurement.com,REJECT
DOMAIN-SUFFIX,app-analytics-services.com,REJECT
DOMAIN-SUFFIX,crashlyticsreports-pa.googleapis.com,REJECT

# ================= 通用广告联盟 =================
DOMAIN-SUFFIX,amazon-adsystem.com,REJECT
DOMAIN-SUFFIX,adsrvr.org,REJECT
DOMAIN-SUFFIX,adnxs.com,REJECT
DOMAIN-SUFFIX,scorecardresearch.com,REJECT
DOMAIN-SUFFIX,moatads.com,REJECT
DOMAIN-SUFFIX,taboola.com,REJECT
DOMAIN-SUFFIX,outbrain.com,REJECT
DOMAIN-SUFFIX,criteo.com,REJECT
DOMAIN-SUFFIX,criteo.net,REJECT
DOMAIN-SUFFIX,adcolony.com,REJECT
DOMAIN-SUFFIX,applovin.com,REJECT
DOMAIN-SUFFIX,unityads.unity3d.com,REJECT
DOMAIN-SUFFIX,vungle.com,REJECT
DOMAIN-SUFFIX,chartboost.com,REJECT
DOMAIN-SUFFIX,ironsrc.com,REJECT
DOMAIN-SUFFIX,supersonicads.com,REJECT
DOMAIN-SUFFIX,inmobi.com,REJECT
DOMAIN-SUFFIX,startapp.com,REJECT
DOMAIN-SUFFIX,mintegral.com,REJECT
DOMAIN-SUFFIX,pangle.io,REJECT

# ---- X / Twitter 强制走代理 (早于 GEOIP,CN,DIRECT) ----
DOMAIN-SUFFIX,x.com,PROXY
DOMAIN-SUFFIX,twitter.com,PROXY
DOMAIN-SUFFIX,twimg.com,PROXY
DOMAIN-SUFFIX,t.co,PROXY
DOMAIN-SUFFIX,instagram.com,PROXY
DOMAIN-SUFFIX,cdninstagram.com,PROXY
DOMAIN-SUFFIX,fbcdn.net,PROXY

[URL Rewrite]
^https?:\/\/api\.(twitter|x)\.com\/1\.1\/ads\/ - reject-dict

[Script]
X-AdBlock = type=http-response, pattern=^https?:\/\/(api\.(twitter|x)\.com|((www|mobile|m)\.)?(x|twitter)\.com)\/(i\/api\/)?graphql\/[-_A-Za-z0-9]+\/(HomeTimeline|HomeLatestTimeline|HomeTimelineUrt|SearchTimeline|UserTweets|UserTweetsAndReplies|UserMedia|TweetDetail|BookmarkSearchTimeline|Bookmarks|Likes|ListLatestTweetsTimeline|ListTweetsTimeline|CommunityTweetsTimeline|CommunityMediaTimeline|ConnectTabTimeline|GenericTimelineById|ViewerTimeline|TimelineHome|TimelineHomeLatest|HomeTimelineV2|HomeLatestTimelineV2|ViewerHomeTimeline)(\?|$), requires-body=1, max-size=1048576, timeout=30, script-path=https://raw.githubusercontent.com/xiaoyinge/Shadowrocket-X-AdBlock/main/x_ads.js

# chat-ws.x.com 是 wss:// WebSocket, 被 MITM 拆散后时间线永不加载
[MITM]
hostname = %APPEND% api.x.com, api.twitter.com
